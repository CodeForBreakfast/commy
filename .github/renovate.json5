{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  rangeStrategy: 'pin',
  automerge: true,
  dependencyDashboard: {
    enabled: true,
  },
  ignorePaths: [
    'packages/core/package.json',
  ],
  packageRules: [
    {
      matchPackageNames: [
        '*',
      ],
      minimumReleaseAge: '7 days',
    },
    {
      matchUpdateTypes: [
        'minor',
        'major',
      ],
      automerge: false,
      addLabels: [
        'renovate/needs-review',
      ],
    },
    {
      matchManagers: [
        'bun',
      ],
      rangeStrategy: 'bump',
    },
    {
      matchPackageNames: [
        'typescript',
        '@effect/tsgo',
      ],
      groupName: 'typescript and @effect/tsgo',
    },
    {
      matchPackageNames: [
        'effect',
        '@effect/*',
        '!@effect/tsgo',
      ],
      groupName: 'effect',
    },
    {
      matchDepTypes: [
        'requires-python',
        'build-system.requires',
      ],
      enabled: false,
    },
  ],
}
